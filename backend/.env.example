# Copy this file to backend/.env and fill in real values. Never commit .env.

# Server
PORT=3000
# Required. The server refuses to start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Comma-separated list of browser origins allowed to call the API.
# Defaults to https://marcoandresrivas.github.io when empty.
CORS_ORIGINS=https://marcoandresrivas.github.io,http://localhost:5500,http://127.0.0.1:5500

# MySQL (Aiven in production)
DB_SERVER=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=shaolin_chile
DB_SSL=false

# SMTP for confirmation emails (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Seed scripts: initial passwords. Each seed refuses to run without its own variable.
SEED_ADMIN_PASSWORD=
SEED_ALUMNO_PASSWORD=
SEED_MAXI_PASSWORD=
SEED_BENJA_PASSWORD=
SEED_MARCO_PASSWORD=

# Bank transfer details for seminars and courses (all optional: the message
# leaves out what is empty and says the details will be sent).
PAGO_BANCO=
PAGO_TIPO_CUENTA=
PAGO_NUMERO_CUENTA=
PAGO_TITULAR=
PAGO_RUT=
PAGO_EMAIL=
# Where people send the receipt from the site, e.g. "por WhatsApp al +56 9 8615 7545".
PAGO_COMPROBANTE_A=
