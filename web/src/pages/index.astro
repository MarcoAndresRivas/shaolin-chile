---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import TrialClassForm from '../components/TrialClassForm.jsx';
import {
  hero,
  history,
  disciplines,
  disciplinesHead,
  disciplinesIntro,
  benefits,
  benefitsHead,
  benefitsIntro,
  locations,
  locationsHead,
  schedules,
  gallery,
  galleryHead,
  cta,
  contact,
} from '../data/site.js';
import { instagramImage, instagramPostUrl } from '../lib/images.js';

const heroImage = instagramImage('CABV5wqpxzD');
const historyImage = instagramImage('Bppn2h8lX4g');
---

<Base title="Inicio" description={hero.description}>
  <section class="hero">
    <Image
      class="hero__bg"
      src={heroImage}
      alt=""
      widths={[640, 1080]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="container hero__content">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1>{hero.titleLine1}<br />{hero.titleLine2}</h1>
      <p class="hero__lead">{hero.description}</p>
      <div class="hero__actions">
        <a class="btn btn--gold" href="#clase-de-prueba">{hero.primaryCta}</a>
        <a class="btn btn--ghost" href="#disciplinas">{hero.secondaryCta}</a>
      </div>
    </div>
  </section>

  <section id="nosotros" class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">{history.eyebrow}</p>
        <h2 class="split__title">{history.title}</h2>
        {history.paragraphs.map((text) => <p class="split__text">{text}</p>)}
        <ul class="highlights">
          {history.highlights.map((text) => <li>{text}</li>)}
        </ul>
      </div>
      <figure class="split__media">
        <div class="stat"><strong>{history.stat.value}</strong><span>{history.stat.label}</span></div>
        <Image src={historyImage} alt="Practicante junto a un monje con túnica naranja" widths={[400, 682]} sizes="(max-width: 860px) 100vw, 45vw" />
      </figure>
    </div>
  </section>

  <section id="disciplinas" class="section section--alt">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{disciplinesHead.eyebrow}</p>
        <h2>{disciplinesHead.title}</h2>
        <p>{disciplinesIntro}</p>
      </div>
      <div class="cards">
        {
          disciplines.map((discipline) => (
            <article class="card">
              <Image
                class="card__img"
                src={instagramImage(discipline.image)}
                alt=""
                widths={[360, 640]}
                sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 25vw"
              />
              <div class="card__body">
                <h3>{discipline.name}</h3>
                <p>{discipline.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="beneficios" class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{benefitsHead.eyebrow}</p>
        <h2>{benefitsHead.title}</h2>
        <p>{benefitsIntro}</p>
      </div>
      <ol class="benefits">
        {benefits.map((benefit) => <li><h3>{benefit.title}</h3><p>{benefit.text}</p></li>)}
      </ol>
    </div>
  </section>

  <section id="sedes" class="section section--alt">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{locationsHead.eyebrow}</p>
        <h2>{locationsHead.title}</h2>
      </div>
      <div class="locations">
        {
          locations.map((location) => (
            <article class="location">
              <p class="location__city">{location.city}</p>
              <h3>{location.name}</h3>
              <p>{location.description}</p>
              <p class={location.address ? 'location__address' : 'location__address pending'}>
                {location.address ?? 'Dirección por confirmar'}
              </p>
            </article>
          ))
        }
      </div>

      <h3 class="schedules__title">Horarios de clases</h3>
      <div class="schedules">
        {
          schedules.map((item) => (
            <article class="schedule">
              <p class="schedule__discipline">{item.discipline}</p>
              <p class="schedule__days">{item.days}</p>
              <p class="schedule__time">{item.time}</p>
            </article>
          ))
        }
      </div>
      <p class="schedules__note">Consulta por WhatsApp la sede y el horario que más te acomoden.</p>
    </div>
  </section>

  <section id="galeria" class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{contact.instagramHandle}</p>
        <h2>{galleryHead.title}</h2>
        <p>{galleryHead.intro}</p>
      </div>
      <div class="gallery">
        {
          gallery.map((item) => (
            <a class="gallery__item" href={instagramPostUrl(item)} target="_blank" rel="noopener">
              <Image src={instagramImage(item.id)} alt={item.alt} widths={[360, 640]} sizes="(max-width: 640px) 50vw, 25vw" />
              {item.kind === 'reel' && <span class="gallery__badge">Video</span>}
            </a>
          ))
        }
      </div>
      <p class="gallery__more">
        <a class="btn btn--ghost" href={contact.instagram} target="_blank" rel="noopener">Ver más en Instagram</a>
      </p>
    </div>
  </section>

  <section id="clase-de-prueba" class="section section--alt">
    <div class="container split">
      <div>
        <p class="eyebrow">Únete a nosotros</p>
        <h2 class="split__title">{cta.title}</h2>
        <p class="split__text">{cta.description}</p>
        <p class="split__text">La primera clase es gratuita. Completa el formulario y coordinamos contigo por WhatsApp.</p>
      </div>
      <TrialClassForm
        client:visible
        disciplines={disciplines.filter((d) => d.slug !== 'cursos-online').map((d) => d.name)}
        locations={locations.map((l) => l.city)}
        whatsapp={contact.whatsapp}
      />
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    min-height: min(88vh, 760px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .hero :global(.hero__bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(11, 11, 12, 0.92) 0%, rgba(11, 11, 12, 0.7) 50%, rgba(11, 11, 12, 0.35) 100%);
  }
  .hero__content {
    position: relative;
    z-index: 1;
    padding-top: 80px;
    padding-bottom: 80px;
  }
  .hero h1 {
    font-size: clamp(2.4rem, 7vw, 5rem);
    text-transform: uppercase;
    max-width: 14ch;
  }
  .hero__lead {
    max-width: 520px;
    font-size: 1.1rem;
    color: #d8d3ca;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 28px;
  }

  .split {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .split__title {
    font-size: clamp(1.9rem, 4vw, 2.8rem);
  }
  .split__text {
    color: var(--muted);
  }
  .split__media {
    margin: 0;
  }
  .split__media :global(img) {
    border-radius: var(--radius);
    border: 1px solid var(--border);
    width: 100%;
  }

  .highlights {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .highlights li {
    position: relative;
    padding-left: 28px;
  }
  .highlights li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 14px;
    height: 2px;
    background: var(--gold);
  }
  .split__media {
    position: relative;
  }
  .stat {
    position: absolute;
    left: -18px;
    bottom: -18px;
    z-index: 1;
    display: grid;
    padding: 18px 22px;
    border-radius: var(--radius);
    background: var(--red);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
  }
  .stat strong {
    font-family: var(--font-display);
    font-size: 2.4rem;
    line-height: 1;
    color: var(--gold-soft);
  }
  .stat span {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .schedules__title {
    margin-top: 56px;
    font-size: 1.4rem;
  }
  .schedules {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .schedule {
    padding: 22px 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
  }
  .schedule p {
    margin: 0;
  }
  .schedule__discipline {
    font-family: var(--font-display);
    color: var(--gold);
    font-size: 1.05rem;
  }
  .schedule__days {
    color: var(--muted);
  }
  .schedule__time {
    font-size: 1.3rem;
    font-weight: 600;
  }
  .schedules__note {
    margin-top: 18px;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }
  .card {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .card :global(.card__img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .card__body {
    padding: 22px;
  }
  .card h3 {
    font-size: 1.15rem;
    color: var(--gold);
  }
  .card p {
    color: var(--muted);
    font-size: 0.93rem;
    margin: 0;
  }

  .benefits {
    list-style: none;
    counter-reset: benefit;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin: 0;
    padding: 0;
  }
  .benefits li {
    counter-increment: benefit;
    position: relative;
    padding: 28px 24px 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    font-size: 1.02rem;
  }
  .benefits h3 {
    font-size: 1.1rem;
    color: var(--gold);
    margin-bottom: 6px;
  }
  .benefits p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .benefits li::before {
    content: counter(benefit, decimal-leading-zero);
    display: block;
    font-family: var(--font-display);
    color: var(--red-strong);
    font-size: 1.6rem;
    font-weight: 800;
    margin-bottom: 8px;
  }

  .locations {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .location {
    padding: 28px;
    border: 1px solid var(--border);
    border-top: 3px solid var(--gold);
    border-radius: var(--radius);
    background: var(--surface-2);
  }
  .location__city {
    color: var(--gold);
    font-family: var(--font-display);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-size: 0.8rem;
    margin-bottom: 6px;
  }
  .location h3 {
    font-size: 1.2rem;
  }
  .location p {
    color: var(--muted);
  }
  .location__address {
    margin: 0;
    font-size: 0.9rem;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }
  .gallery__item {
    position: relative;
    display: block;
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 1;
  }
  .gallery__item:first-child {
    grid-column: span 2;
    grid-row: span 2;
  }
  /* Big tile + four squares + two wide tiles fill whole rows in 4 and 2 columns. */
  .gallery__item:nth-last-child(-n + 2) {
    grid-column: span 2;
    aspect-ratio: 2 / 1;
  }
  .gallery__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }
  .gallery__item:hover :global(img) {
    transform: scale(1.04);
  }
  .gallery__badge {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 3px 9px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.7);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }
  .gallery__more {
    text-align: center;
    margin-top: 32px;
  }

  @media (max-width: 1100px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 860px) {
    .split,
    .benefits,
    .locations,
    .schedules {
      grid-template-columns: 1fr;
    }
    .gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .cards {
      grid-template-columns: 1fr;
    }
    .hero__actions .btn {
      width: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery__item :global(img) {
      transition: none;
    }
  }
</style>
