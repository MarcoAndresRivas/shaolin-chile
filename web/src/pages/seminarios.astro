---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Ofertas from '../components/Ofertas.jsx';
import { contact, seminarVideos } from '../data/site.js';
import { instagramImage, instagramPostUrl } from '../lib/images.js';
---

<Base title="Seminarios y cursos" description="Reserva tu cupo en los seminarios de Kung Fu Shaolin y compra los cursos online con videos de las clases.">
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Seminarios y cursos online</p>
        <h1>Entrena con nosotros</h1>
        <p>Elige los días del seminario o un curso online, reserva tu cupo y paga por transferencia.</p>
      </div>
      <div class="videos">
        {
          seminarVideos.map((video) => (
            <a class="videos__item" href={instagramPostUrl(video)} target="_blank" rel="noopener">
              <Image src={instagramImage(video.id)} alt={video.alt} widths={[320, 480]} sizes="(max-width: 640px) 50vw, 240px" />
              <span class="videos__badge">Video</span>
              <span class="videos__title">{video.title}</span>
            </a>
          ))
        }
      </div>
      <Ofertas client:load whatsapp={contact.whatsapp} />
    </div>
  </section>
</Base>

<style>
  .videos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 150px), 1fr));
    gap: 12px;
    margin-bottom: 40px;
  }
  .videos__item {
    position: relative;
    display: block;
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 9 / 16;
    max-width: 280px;
  }
  .videos__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }
  .videos__item:hover :global(img) {
    transform: scale(1.04);
  }
  .videos__badge {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 3px 9px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.7);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }
  .videos__title {
    position: absolute;
    inset: auto 0 0;
    padding: 28px 12px 12px;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
  }
  @media (prefers-reduced-motion: reduce) {
    .videos__item :global(img) {
      transition: none;
    }
  }
</style>
